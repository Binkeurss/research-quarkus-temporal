    @MappedSuperclass
    public abstract class BaseEntity extends PanacheEntity {

        public LocalDateTime createdAt;
        public LocalDateTime updatedAt;

        @PrePersist
        void prePersist() {
            createdAt = LocalDateTime.now();
            updatedAt = LocalDateTime.now();
        }

        @PreUpdate
        void preUpdate() {
            updatedAt = LocalDateTime.now();
        }
    }